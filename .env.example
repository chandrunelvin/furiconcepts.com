# Copy this file to .env on the server and fill in the SMTP account.
# server.js reads it and emails every website form with Nodemailer.

# SMTP account the website sends from (e.g. Hostinger: smtp.hostinger.com, port 465)
SMTP_HOST=
SMTP_PORT=465
# true for port 465 (SSL), false for port 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Sender address shown on the emails (usually the same as SMTP_USER)
MAIL_FROM=

# Who receives the form emails (comma separated)
MAIL_TO=letstalk@furniconcepts.com,chandru@hubble-web.com

# The hosting panel normally sets PORT itself; 3000 is used locally
# PORT=3000
